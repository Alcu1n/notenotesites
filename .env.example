NEXT_PUBLIC_SITE_URL=https://pinypiny.lraitech.com
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6804919805

# Copy the real pt value from an App Store Connect campaign URL. Blank keeps a plain download link.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
# Optional anonymous website analytics. Blank ID means no script is loaded.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Optional search ownership verification tokens. Never put a private API key here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
